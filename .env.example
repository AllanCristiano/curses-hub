# Aplicação
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
PAGINATION_MAX_LIMIT=100
SWAGGER_ENABLED=true

# Banco de dados (PostgreSQL via Docker Compose)
POSTGRES_USER=hcode
POSTGRES_PASSWORD=hcode
POSTGRES_DB=hcode_hub
DATABASE_URL=postgresql://hcode:hcode@localhost:5432/hcode_hub?schema=public

# Banco de dados de testes (integração/E2E)
TEST_DATABASE_URL=postgresql://hcode:hcode@localhost:5433/hcode_hub_test?schema=public

# JWT (troque em produção!)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting dos endpoints de autenticação
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# Segredo compartilhado do webhook de pagamento
PAYMENT_WEBHOOK_SECRET=change-me-webhook
